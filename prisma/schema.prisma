generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId    Int   @id @default(autoincrement()) @map("user_id")
  name      String  
  pin       String
  studentId String  @map("student_id")
  email     String
  kakaoId   String? @map("kakao_id")
  instaId   String? @map("insta_id")

  matchParticipants MatchParticipant[]
   posts    Post[]
  comments Comment[]

  @@map("user")
}

model Matching {
  matchId     Int       @id @default(autoincrement()) @map("match_id")
  matchType   MatchType @map("match_type")
  personalNum Int?      @map("personal_num")
  groupNum    Int?      @map("group_num")

  matchParticipants MatchParticipant[]

  @@map("matching")
}

model MatchParticipant {
  userId  Int  @map("user_id")
  matchId Int   @map("match_id")

  user    User      @relation(fields: [userId], references: [userId])
  matching Matching @relation(fields: [matchId], references: [matchId])

  @@id([userId, matchId]) // 복합 기본 키
  @@map("match_participant")
}

enum MatchType {
  INDIVIDUAL
  GROUP
}


model Post {
  postId       Int   @id @default(autoincrement())
  userId       Int
  title        String   @db.VarChar(255)
  content      String   @db.Text
  likeCount    Int      @default(0) @map("like_count")
  dislikeCount Int      @default(0) @map("dislike_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  user      User      @relation(fields: [userId], references: [userId])
  comments  Comment[]
  postTags  PostTag[]
}

model Comment {
  commentId      Int       @id @default(autoincrement())
  userId         Int
  postId         Int
  content        String    @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @map("updated_at")
  parentCommentId Int?    

  user           User      @relation(fields: [userId], references: [userId])
  post           Post      @relation(fields: [postId], references: [postId])
  parentComment  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [commentId])
  replies        Comment[] @relation("CommentReplies")

}

model PostTag {
  postId Int
  tagId  Int @map("tag_id")

  post Post @relation(fields: [postId], references: [postId])
  tag  Tag  @relation(fields: [tagId], references: [tagId])

  @@id([postId, tagId])
}

model Tag {
  tagId Int @id @default(autoincrement()) @map("tag_id")
  name  String @db.VarChar(255)

  postTags PostTag[]
}