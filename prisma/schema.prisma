generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId    Int       @id @default(autoincrement()) @map("user_id")
  name      String  
  pin       String
  studentId String    @map("student_id")
  email     String
  kakaoId   String?   @map("kakao_id")
  instaId   String?   @map("insta_id")
  mbti      String?
  bio       String? 

  matchParticipants MatchParticipant[]
  posts    Post[]
  comments Comment[]
  chatParticipants ChatParticipant[]
  messages Message[]
  postLikes PostLike[] 

  @@map("user")
}

model Matching {
  matchId     Int       @id @default(autoincrement()) @map("match_id")
  matchType   MatchType @map("match_type")
  personalNum Int?      @map("personal_num")
  groupNum    Int?      @map("group_num")

  matchParticipants MatchParticipant[]

  @@map("matching")
}

model MatchParticipant {
  userId  Int  @map("user_id")
  matchId Int   @map("match_id")

  user    User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  matching Matching @relation(fields: [matchId], references: [matchId])

  @@id([userId, matchId]) // 복합 기본 키
  @@map("match_participant")
}

enum MatchType {
  INDIVIDUAL
  GROUP
}

enum RoomType {
  INDIVIDUAL
  GROUP
}

model Post {
  postId       Int       @id @default(autoincrement())
  userId       Int
  title        String    @db.VarChar(255)
  content      String    @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  comments  Comment[]
  postTags  PostTag[]
  likedBy      PostLike[]

  @@map("post")
}

model PostLike {
  userId  Int  @map("user_id")
  postId  Int  @map("post_id")

  user    User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post    Post  @relation(fields: [postId], references: [postId])

  @@id([userId, postId])
  @@map("post_like")
}

model Comment {
  commentId      Int       @id @default(autoincrement())
  userId         Int
  postId         Int
  content        String    @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @map("updated_at")
  parentCommentId Int?    

  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post           Post      @relation(fields: [postId], references: [postId])
  parentComment  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [commentId])
  replies        Comment[] @relation("CommentReplies")

  @@map("comment")
}

model PostTag {
  postId Int  @map("post_id")
  tagId  Int  @map("tag_id")

  post Post @relation(fields: [postId], references: [postId])
  tag  Tag  @relation(fields: [tagId], references: [tagId])

  @@id([postId, tagId])

  @@map("post_tag")
}

model Tag {
  tagId Int @id @default(autoincrement()) @map("tag_id")
  name  String @db.VarChar(255)

  postTags PostTag[]

  @@map("tag")
}

model VerificationCode {
  id          Int    @id @default(autoincrement())
  email       String @unique
  code        String @db.VarChar(6) 
  expiresAt   DateTime @map("expires_at") 
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("verification_code")
}

model Room {
  roomId    Int              @id @default(autoincrement()) @map("room_id")
  roomName  String           @db.VarChar(255) @map("room_name")
  RoomType   RoomType @map("room_type")
  createdAt DateTime         @default(now()) @map("created_at")
  participants ChatParticipant[]
  messages    Message[]

  @@map("room")
}

model Message {
  messageId  Int      @id @default(autoincrement()) @map("message_id")
  roomId     Int      @map("room_id")
  senderId   Int      @map("sender_id")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  room       Room     @relation(fields: [roomId], references: [roomId])
  sender     User     @relation(fields: [senderId], references: [userId], onDelete: Cascade)

  @@map("message")
}

model ChatParticipant {
  userId  Int    @map("user_id")
  roomId  Int    @map("room_id")

  user    User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  room    Room   @relation(fields: [roomId], references: [roomId])

  @@id([userId, roomId])
  @@map("chat_participant")
}
